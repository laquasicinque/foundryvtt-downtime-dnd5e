{
    "name": "downtime-dnd5e",
    "title": "Tracking, Training & Downtime (5e)",
    "description": "Adds a tab to the character sheet to keep track of downtime activities, training, spell scribing, faction reputation, quest progress, and anything else you can think of.",
    "version": "13.0.8",
    "main": "module.js",
    "license": "SEE LICENSE IN LICENSE",
    "private": true,
    "type": "module",
    "packageManager": "npm@12.0.2",
    "author": "",
    "contributors": [],
    "devDependencies": {
        "@sveltejs/vite-plugin-svelte": "^6.1.2",
        "@tsconfig/svelte": "^5.0.8",
        "@types/node": "^24.19.2",
        "@typescript/native": "npm:typescript@^7.0.2",
        "svelte": "^5.57.0",
        "svelte-check": "^4.7.7",
        "typescript": "~6.0.3",
        "vite": "npm:@voidzero-dev/vite-plus-core@0.3.0",
        "vite-plugin-clean": "^2.0.1",
        "vite-plugin-static-copy": "^3.1.1",
        "vite-plus": "0.3.0"
    },
    "browserslist": [
        ">5%",
        "not IE 11"
    ],
    "scripts": {
        "clean": "node ./utils/clean.mjs",
        "build": "vp run clean && vp build",
        "build:watch": "vp run clean && vp build --watch --mode development",
        "dev": "vp dev",
        "format": "vp fmt",
        "lint": "vp lint",
        "lint:fix": "vp lint --fix",
        "check": "vp check",
        "check:svelte": "svelte-check --tsconfig ./tsconfig.json --tsgo",
        "prepare": "vp config"
    },
    "devEngines": {
        "packageManager": {
            "name": "npm",
            "version": "12.0.2",
            "onFail": "download"
        }
    },
    "overrides": {
        "vite": "npm:@voidzero-dev/vite-plus-core@0.3.0",
        "vitest": "4.1.11"
    },
    "dependencies": {
        "it-al": "^1.3.11"
    }
}
